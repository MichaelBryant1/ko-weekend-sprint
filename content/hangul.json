    { "id": "hangul_batchim", "group": "batchim_overview", "order": 41, "symbol": "받침", "name_ko": "받침", "romanization": "final consonants", "sound_note": "A consonant in the bottom slot of a syllable is a 'batchim'. All final consonants collapse to one of 7 sounds: ㄱ, ㄴ, ㄷ, ㄹ, ㅁ, ㅂ, ㅇ. For example ㅅ, ㅈ, ㅊ, ㅌ, ㅎ at the end all sound like ㄷ (a stopped 't'). When the next syllable starts with ㅇ, the batchim moves over and is pronounced fully.", "position_note": "Overview tile — not part of the 40-letter review deck.", "examples": [ {"ko":"밥","en":"rice (ㅂ batchim)","romaja":"bap"}, {"ko":"꽃","en":"flower (ㅊ → ㄷ sound)","romaja":"kkot"}, {"ko":"한국","en":"Korea (ㄴ, ㄱ batchim)","romaja":"hanguk"} ] }
